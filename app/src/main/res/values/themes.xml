<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.silys" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/base_blue_color</item>
        <item name="fontFamily">@font/instrument_sans</item>
        <item name="android:fontFamily">@font/instrument_sans</item>
        <item name="colorControlActivated">@color/blue_light</item>
        <item name="colorOnSurface">@color/blue_light</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="Theme.silys.Splash" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="windowSplashScreenBackground">@color/white</item>
        <!--<item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>-->
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.silys</item>
    </style>

    <style name="EditTextStyle" parent="@style/TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/font_color</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="CustomEditText" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">

        <item name="boxBackgroundColor">@android:color/white</item>
        <item name="boxStrokeColor">@color/font_color</item>
        <item name="android:textColorHint">@color/font_color</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1dp</item>

    </style>

    <style name="CustomTextView" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/font_color</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/instrument_sans</item>
    </style>

    <style name="CustomButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/base_blue_color</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:insetTop">8dp</item>
        <item name="android:insetBottom">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CustomButtonStyleRed" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/red</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:insetTop">8dp</item>
        <item name="android:insetBottom">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="CustomButtonStyleGreen" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/green</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:insetTop">8dp</item>
        <item name="android:insetBottom">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>